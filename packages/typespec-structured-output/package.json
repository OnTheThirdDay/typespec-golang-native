{
  "name": "typespec-structured-output",
  "version": "0.1.0",
  "description": "TypeSpec emitter producing OpenAI Structured Outputs JSON Schemas with a versioned Pydantic v2 compatibility profile.",
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "tspMain": "lib/main.tsp",
  "exports": {
    ".": {
      "typespec": "./lib/main.tsp",
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./testing": {
      "types": "./dist/src/testing/index.d.ts",
      "default": "./dist/src/testing/index.js"
    }
  },
  "files": [
    "lib/*.tsp",
    "dist/src/**",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE",
    "LICENSE.apache"
  ],
  "scripts": {
    "build": "tsc -p .",
    "test": "tsc -p . && vitest run",
    "test:openai": "node acceptance/openai-acceptance.mjs"
  },
  "peerDependencies": {
    "@typespec/compiler": "~1.18.0",
    "@typespec/versioning": "~0.88.0"
  },
  "devDependencies": {
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/json-schema": "1.18.0",
    "@typespec/versioning": "0.88.0"
  },
  "peerDependenciesMeta": {
    "@typespec/versioning": {
      "optional": true
    }
  },
  "dependencies": {
    "jsonc-parser": "3.3.1"
  }
}
